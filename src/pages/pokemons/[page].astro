---
import type { GetStaticPaths } from 'astro';
import PokemonCard from '../../components/pokemons/PokemonCard.astro';
import type { PokemonListResponse } from '../../interfaces/pokemon-list.response';

import MainLayout from '../../layouts/MainLayout.astro';
import { url } from 'astro:schema';

export const getStaticPaths = (async ({ paginate }) => {
  const resp = await fetch('https://pokeapi.co/api/v2/pokemon?limit=151');
  const { results } = (await resp.json()) as PokemonListResponse;

  return paginate(results, { pageSize: 20 });
}) satisfies GetStaticPaths;

const title = 'Pokémon Static | Home';
const { page } = Astro.props;

console.log(page.url.prev);
---

<MainLayout title={title}>
  <h1 class="text-3xl font-bold mb-4">Listado de Pokémons</h1>
  <hr class="border-slate-700 mb-4" />

  <section
    aria-label="Listado de Pokémons"
    class="grid grid-cols-1 sm:grid-cols-4 md:grid-cols-5 gap-4 mt-5"
  >
    {page.data.map(({ name, url }) => <PokemonCard name={name} url={url} />)}
  </section>

  <section class="flex mt-10 gap-2 i tems-center">
    <a class="btn" href={page.url.prev}>Anteriores</a>
    <a class="btn" href={page.url.next}>Siguientes</a>

    <div class="flex flex-1"></div>

    <span>Página 1</span>
  </section>
</MainLayout>

<style>
  @reference "tailwindcss";

  .btn {
    @apply bg-blue-500 p-2 text-white rounded-md;
  }

  .disabled {
    @apply bg-gray-500 text-gray-400;
  }
</style>