---
import { ClientRouter } from 'astro:transitions';
import NavBar from '../components/shared/NavBar.astro';

interface Props {
  title: string;
  description?: string;
  image?: string;
}

const { title, description, image } = Astro.props;
---

<html lang="en">
  <head>
    <!-- Required -->
    <title>{title}</title>

    <ClientRouter />
    <!-- <style>
      @view-transition {
        navigation: auto; /* enabled! */
      }
    </style> -->
  </head>

  <body class="bg-slate-800 text-slate-100">
    <NavBar />
    <main class="mt-10 m-auto max-w-3xl mx-4">
      <slot />
    </main>
  </body>
</html>